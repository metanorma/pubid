# frozen_string_literal: true

require "yard"

namespace :docs do
  # Generates docs/api-reference.md from the YARD registry over lib/ —
  # the generated API reference the website assembles (pubid#577). CI
  # regenerates and fails on drift, so the committed file cannot rot.
  desc "Generate docs/api-reference.md from YARD"
  task :api_reference do
    require "pubid"
    Pubid.eager_load_flavors!
    YARD::Registry.clear
    YARD::Parser::SourceParser.parse(Dir.glob("lib/**/*.rb").sort, [])

    entry = lambda do |obj|
      sig = obj.signature.to_s.strip.sub(/\Adef\s+/, "").gsub(/\s+/, " ")
      doc = obj.docstring.strip.lines.first.to_s.strip
      out = +"### `#{sig}`\n"
      out << "\n#{doc}\n" unless doc.empty?
      out
    end

    module_section = lambda do |path, names|
      mod = YARD::Registry.at(path)
      return "" unless mod

      out = +"## `#{path}`\n\n"
      names.sort.each do |name|
        obj = mod.child("::#{name}") || mod.child(name.to_s)
        out << entry.call(obj) if obj
      end
      out
    end

    out = +<<~HEADER
      # API reference

      <!-- Generated by `rake docs:api_reference` (YARD over lib/) — do not
           edit by hand; CI fails on drift. The website assembles this file
           into the library reference. -->

    HEADER

    out << module_section.call(
      "Pubid",
      %w[parse from_hash locate_stage locate_stage_flavors prefixes
         prefix_flavors parse_by_prefix],
    )
    errors = YARD::Registry.at("Pubid::Errors")
    if errors
      out << "## `Pubid::Errors`\n\n"
      errors.children
        .select { |c| c.is_a?(YARD::CodeObjects::ClassObject) }
        .sort_by(&:name).each do |klass|
        sig = "Pubid::Errors::#{klass.name}"
        sup = klass.superclass.to_s.split("::").last
        doc = klass.docstring.strip.lines.first.to_s.strip
        out << "### `#{sig} < #{sup}`\n"
        out << "\n#{doc}\n" unless doc.empty?
      end
    end

    Pubid::Registry.flavor_names.sort.each do |flavor|
      mod = Pubid::Registry.get(flavor)
      names = %w[parse parse_urn locate_stage locate_stage_by_harmonized_code
                 locate_type prefixes all_typed_stages all_project_stages]
        .select { |m| mod.respond_to?(m) }
      out << module_section.call(mod.name, names)
    end

    id_klass = YARD::Registry.at("Pubid::Identifier")
    if id_klass
      out << "## `Pubid::Identifier` (instance methods)\n\n"
      id_klass.meths(scope: :instance, inherited: false)
        .select { |m| m.visibility == :public }
        .sort_by(&:name).each do |obj|
        out << entry.call(obj)
      end
    end

    File.write("docs/api-reference.md", out)
    puts "docs/api-reference.md: #{out.lines.count} lines, " \
           "#{Pubid::Registry.flavor_names.size} flavors"
  end
end
