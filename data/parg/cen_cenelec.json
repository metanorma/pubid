:null,"tag":"Repetition"}},{"Sequence":{"atoms":[219,220,222,223,225,226,228]}},{"Named":{"name":"version","atom":229}},{"Repetition":{"atom":218,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":86}},{"Repetition":{"atom":232,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[215,216,217,231,233]}},{"Repetition":{"atom":234,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":239}},{"Entity":{"atom":181}},{"Repetition":{"atom":237,"min":0,"max":null,"tag":"Repetition"}},{"Named":{"name":"supplements","atom":238}},{"Entity":{"atom":189}},{"Repetition":{"atom":240,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[111,200,214,235,236,241]}},{"Alternative":{"atoms":[0,242]}}],"root":243},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":["rule publisher: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule publisher: branches 1 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule publisher: branches 2 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule date: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule adopted_org_prefix: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule any_noln_char: branches 1 and 2 are order-dependent (first set not statically known)","rule fragment_identifier: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule identifier: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)"]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"EN 18216:2026","expect":{}},{"entry":"identifier","kind":"accept","input":"EN ISO 9001:2015","expect":{}},{"entry":"identifier","kind":"accept","input":"CEN/CLC TR 17161:2019","expect":{}},{"entry":"identifier","kind":"accept","input":"EN 196-1:2016+A1","expect":{}},{"entry":"identifier","kind":"accept","input":"CEN/CLC/ETSI/TR 101551:2026","expect":{}},{"entry":"identifier","kind":"accept","input":"EN 302 326-2:2026","expect":{}},{"entry":"identifier","kind":"accept","input":"EN 302 326-2 V2.2.1","expect":{}},{"entry":"identifier","kind":"accept","input":"EN 302 326 V2.2.1:2026","expect":{}},{"entry":"identifier","kind":"accept","input":"EN 302:2026","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/cen_cenelec/parser.rb. Pre-parse normalization\n# (U+2011/AD dashes, comment stripping, CEN-CLC/GUIDE forms) stays\n# binder-side: the grammar sees normalized input.\n\ngrammar PubidCenCenelec version \"0.2.0\" {\n  digit = %x30-39\n  space = \" \"\n  dash = \"-\"\n  slash = \"/\"\n  plus = \"+\"\n  colon = \":\"\n  publisher = ((\"CWA\" / \"HD\" / \"ES\" / \"CR\" / \"ENV\") as publisher) / ((\"EN\" / \"CEN\") as publisher [copublishers]) / (\"CLC\" as publisher [copublishers])\n  copublishers = (1*copublisher) as copublishers\n  copublisher = (slash (\"CLC\" / \"ETSI\") as copublisher)\n  stage_prefix = (\"FprEN\" / \"prEN\") as type_with_stage\n  type = (\"Guide\" / \"GUIDE\" / \"TR\" / \"TS\") as type\n  number = ((1*digit) (*(space (1*digit)))) as number\n  version = (space \"V\" (1*digit) \".\" (1*digit) \".\" (1*digit)) as version\n  part = dash (1*(digit / dash)) as part\n  parts = (*part) as parts\n  month_digits = (\"01\" / \"02\" / \"03\" / \"04\" / \"05\" / \"06\" / \"07\" / \"08\" / \"09\" / \"10\" / \"11\" / \"12\") as month\n  year = colon (4digit) as year\n  year_with_month = colon (4digit) as year dash month_digits\n  date = year_with_month / year\n  amendment = (plus as amd_sep_plus / slash as amd_sep_slash) \"A\" (1*digit) as amd_number [(colon (4digit) as amd_year)]\n  corrigendum = (plus as amd_sep_plus / slash as amd_sep_slash) \"AC\" [(digit (*digit)) as cor_number] [(year_with_month / (colon (4digit) as year))]\n  supplement = (amendment / corrigendum) as supplement\n  supplements = (*supplement) as supplements\n  edition = space \"ED\" (1*digit) as edition\n  adopted_org_prefix = \"ISO\" / \"IEC\" / \"CISPR\"\n  adopted_string = (adopted_org_prefix *(!supplement !edition any_noln_char)) as adopted_string\n  any_noln_char = %x01-09 / %x0B-10FFFF\n  fragment_identifier = ((stage_prefix / publisher) space number parts space \"AMD\" (1*digit) as amendment_number space \"FRAG\" (1*digit) as fragment_number) / ((stage_prefix / publisher) space number parts [year] (plus / slash) \"A\" (1*digit) as amendment_number [(colon (4digit) as amendment_year)] space \"FRAG\" (1*digit) as fragment_number)\n  identifier = fragment_identifier / ((stage_prefix / publisher) [(space adopted_string)] [(space type / slash type)] [(space number parts [version] [year])] supplements [edition])\n\n  entry identifier: identifier\n\n  test {\n    accept \"EN 18216:2026\"\n    accept \"EN ISO 9001:2015\"\n    accept \"CEN/CLC TR 17161:2019\"\n    accept \"EN 196-1:2016+A1\"\n    accept \"CEN/CLC/ETSI/TR 101551:2026\"\n    accept \"EN 302 326-2:2026\"\n    accept \"EN 302 326-2 V2.2.1\"\n    accept \"EN 302 326 V2.2.1:2026\"\n    accept \"EN 302:2026\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"eec1427274986950746929b3728c070b9f3fb80141ecc3a1b90e6eebffeb56c5","compiler_version":"1.3.93","checksum":"sha256:f27285171cfe165a0174ed74c63f58e0c70f5fdadb35f62e7a0c9a0835004283"}
