pace_number / dotted_number / complex_number / simple_number) as number\n  minor = space (1*digit) as minor\n  part = dash (1*alnum_char) as part\n  parts = (*part) as parts\n  version = \"V\" (1*version_char) as version\n  edition = \"ed.\" (1*digit) as edition\n  version_or_edition = version / edition\n  date_part = \"(\" (4digit) as year dash (2digit) as month \")\"\n  single_supplement = ((\"/A\" (1*digit) as number) as amendment / (\"/C\" (1*digit) as number) as corrigendum)\n  supplements = (1*single_supplement) as supplements\n  identifier = \"ETSI \" type space number [minor] [parts] [supplements] [(space version_or_edition)] [(space date_part)]\n  alnum_char = %x41-5A / %x61-7A / %x30-39\n  version_char = %x30-39 / %x2E\n  digit = %x30-39\n  dash = \"-\"\n  dot = \".\"\n  space = \" \"\n  entry identifier: identifier\n\n  test {\n    accept \"ETSI EN 300 175\"\n    accept \"ETSI TR 101 999\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"ec499dcff68778e22d0ac6ad29c010bf278a5bde599da0b8e2c1aa28ee59efed","compiler_version":"1.3.93","checksum":"sha256:d57557c42cbbcff863fa709a2b6c043ed752ceb474f5cd8efd6f287c369c812f"}
