\" languages \")\"\n  identifier_with_copublishers = \"ANSI\" as publisher copublishers space std_keyword number_with_part [date] [language]\n  identifier_sole = \"ANSI\" as publisher space std_keyword number_with_part [date] [language]\n  identifier = identifier_with_copublishers / identifier_sole\n  upper = %x41-5A\n  lower = %x61-7A\n  digit = %x30-39\n  dot = \".\"\n  dash = \"-\"\n  colon = \":\"\n  slash = \"/\"\n  space = \" \"\n  entry identifier: identifier\n\n  test {\n    accept \"ANSI C63.4\"\n    accept \"ANSI/IEEE C63.4\"\n    accept \"ANSI Std A119.1\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"18970403b92640703c0de08ee58342989968b026ebd14c80f72928cff1b65dbb","compiler_version":"1.3.93","checksum":"sha256:6b5eb0fa0e4f1ff4e061b4fd8e17d8b468737b3e87b9797b14940e19199cc1ac"}
