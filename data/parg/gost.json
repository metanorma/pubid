ition"}},{"Sequence":{"atoms":[38,53]}},{"Named":{"name":"raw","atom":54}},{"Entity":{"atom":68}},{"Entity":{"atom":6}},{"Repetition":{"atom":57,"min":0,"max":1,"tag":"Maybe"}},{"Repetition":{"atom":58,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":61}},{"Str":{"pattern":"/"}},{"Entity":{"atom":65}},{"Re":{"pattern":"[\\x01-\\x09]"}},{"Re":{"pattern":"[\\x0b-\\u{10ffff}]"}},{"Alternative":{"atoms":[63,64]}},{"Repetition":{"atom":62,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"adopted_raw","atom":66}},{"Sequence":{"atoms":[59,60,67]}},{"Repetition":{"atom":56,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":82}},{"Entity":{"atom":6}},{"Repetition":{"atom":71,"min":0,"max":1,"tag":"Maybe"}},{"Repetition":{"atom":72,"min":0,"max":1,"tag":"Maybe"}},{"Str":{"pattern":"("}},{"Entity":{"atom":78}},{"Re":{"pattern":"[\\x01-\\x28]"}},{"Re":{"pattern":"[\\x2a-\\u{10ffff}]"}},{"Alternative":{"atoms":[76,77]}},{"Repetition":{"atom":75,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"adopted_reference_raw","atom":79}},{"Str":{"pattern":")"}},{"Sequence":{"atoms":[73,74,80,81]}},{"Repetition":{"atom":70,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[0,15,34,35,69,83]}}],"root":84},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":["rule year_sep_core: branches 2 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule any_noln_char: branches 1 and 2 are order-dependent (first set not statically known)","rule no_rparen_char: branches 1 and 2 are order-dependent (first set not statically known)"]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"GOST 12.0.004","expect":{}},{"entry":"identifier","kind":"accept","input":"GOST R 8.568","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/gost/parser.rb — GOST identifiers in Latin and\n# Cyrillic: ГОСТ [Р|R] [copublisher/subtype] <raw>[/adopted|(reference)].\n# prefix_text and raw are captured verbatim; the builder splits them.\n# The Cyrillic character class uses codepoint ranges (%x0410-042F\n# = А-Я, %x0430-044F = а-я), faithful to the source class.\n\ngrammar PubidGost version \"0.1.0\" {\n  gost_word = (\"GOST\" / \"ГОСТ\") as gost_word space\n  scope_r = (\"R\" / \"Р\") as scope_r space\n  prefix_char = %x0410-042F / %x0430-044F / %x2F / %x41-5A / %x61-7A\n  prefix_text = (1*prefix_char *(space 1*prefix_char)) as prefix_text space\n  raw_body = (1*digit *((dot / year_sep_core) [space] 1*digit)) as raw\n  year_sep_core = dash / \"—\" / \"–\"\n  adopted_part = [[space]] slash (1*any_noln_char) as adopted_raw\n  adopted_reference_part = [[space]] \"(\" (1*no_rparen_char) as adopted_reference_raw \")\"\n  identifier = gost_word [scope_r] [prefix_text] raw_body [adopted_part] [adopted_reference_part]\n  any_noln_char = %x01-09 / %x0B-10FFFF\n  no_rparen_char = %x01-28 / %x2A-10FFFF\n  digit = %x30-39\n  dot = \".\"\n  dash = \"-\"\n  slash = \"/\"\n  space = \" \"\n  entry identifier: identifier\n\n  test {\n    accept \"GOST 12.0.004\"\n    accept \"GOST R 8.568\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"bc4461efe1d38cccf66f1c2bc75e5d8001916e27a95c365c9a397c9ac7cfda3f","compiler_version":"1.3.93","checksum":"sha256:2344feb986fa3cdb5d651b9de33a3e607cfdd22a69d398a3e2b97793049f95ef"}
