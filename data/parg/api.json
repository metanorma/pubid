"expect":{}}],"docs":{},"source":"# Port of lib/pubid/api/parser.rb: API MPMS/typed/typeless identifiers\n# with slash-combined second identifiers. The API MPMP normalization\n# stays binder-side.\n\ngrammar PubidApi version \"0.1.0\" {\n  number_with_part = (1*num_letter_char) as number [(dash (1*num_letter_char) as part)]\n  num_letter_char = %x30-39 / %x41-5A\n  doc_type = (\"MPMS\" / \"BULL\" / \"SPEC\" / \"STD\" / \"RP\" / \"TR\" / \"COS\" / \"PUBL\") as type\n  chapter_notation = space \"CH\" space (1*digit) as chapter\n  digits_with_letter = (1*digit [*upper])\n  year = (4digit) as year\n  date_dash = dash year\n  date_colon = colon year\n  reaffirmation = space \"(R\" year \")\"\n  part_notation = \", Part \" (1*digit) as part_number\n  mpms_identifier = \"API \" \"MPMS\" as type chapter_notation [(dot digits_with_letter as section)] [(dot digits_with_letter as subsection)] [(date_dash / date_colon)]\n  typed_identifier = \"API \" doc_type space number_with_part [part_notation] [(date_dash / date_colon)] [reaffirmation]\n  typeless_identifier = \"API \" number_with_part [part_notation] [(date_dash / date_colon)] [reaffirmation]\n  second_identifier = doc_type space number_with_part [part_notation] [(date_dash / date_colon)]\n  combined_identifier = ((mpms_identifier / typed_identifier / typeless_identifier) as first) slash (second_identifier as second) [edition_notation]\n  edition_notation = \", \" (1*digit) as edition_number (\"st\" / \"nd\" / \"rd\" / \"th\") \" edition\"\n  identifier = combined_identifier / mpms_identifier / typed_identifier / typeless_identifier\n  upper = %x41-5A\n  digit = %x30-39\n  dash = \"-\"\n  slash = \"/\"\n  colon = \":\"\n  dot = \".\"\n  space = \" \"\n  entry identifier: identifier\n\n  test {\n    accept \"API RP 1632-1987\"\n    accept \"API MPMS CH 11.1\"\n    accept \"API SPEC 5DP/STD 5DP, 1st edition\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"3677670f05d8deadf593a3947c52867f69d5254aec9773bd014ab6d007f61499",