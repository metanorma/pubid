{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/isbn/parser.rb: [ISBN[ |:]] digits/hyphens with an\n# optional final X (ISBN-10 check digit), per ISO 2108.\n\ngrammar PubidIsbn version \"0.1.0\" {\n  digit = %x30-39\n  x_digit = digit / \"X\"\n  isbn_prefix = [\"ISBN\" (space / ([space] colon [space]))]\n  digit_group = 1*digit\n  hyphen_body = (digit_group *(hyphen digit_group) [hyphen x_digit]) as body\n  plain_body = (9*12digit [x_digit]) as body\n  identifier = [isbn_prefix] (hyphen_body / plain_body)\n  space = \" \"\n  colon = \":\"\n  hyphen = \"-\"\n  entry identifier: identifier\n\n  test {\n    accept \"ISBN 978-0-306-40615-7\"\n    accept \"978-0-306-40615-7\"\n    accept \"0-306-40615-2\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"d4eebf3941bbd75ae025bc425a7ab94bf621ee711ff6cda3fe774d890e2ad526","compiler_version":"1.3.93","checksum":"sha256:0d3c478770389ec2599b18cef2c45ef0fe346d72794ffd6e5542adb1b79b2f0f"}
