{"bindings":null,"version":"0.1.0","grammar":"PubidIetf","shape":"parsanol-tree/v2","binding_version":1,"entries":{"identifier":{"root":"identifier","grammar":{"atoms":[{"Entity":{"atom":9}},{"Str":{"pattern":"RFC"}},{"Entity":{"atom":3}},{"Str":{"pattern":" "}},{"Repetition":{"atom":2,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":6}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":5,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"number","atom":7}},{"Sequence":{"atoms":[1,4,8]}},{"Entity":{"atom":21}},{"Str":{"pattern":"BCP"}},{"Str":{"pattern":"STD"}},{"Str":{"pattern":"FYI"}},{"Alternative":{"atoms":[11,12,13]}},{"Named":{"name":"series","atom":14}},{"Entity":{"atom":3}},{"Repetition":{"atom":16,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":6}},{"Repetition":{"atom":18,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"number","atom":19}},{"Sequence":{"atoms":[15,17,20]}},{"Entity":{"atom":35}},{"Str":{"pattern":"draft-"}},{"Entity":{"atom":32}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Re":{"pattern":"[\\x41-\\x5a]"}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Re":{"pattern":"[+]"}},{"Re":{"pattern":"[_]"}},{"Re":{"pattern":"[.]"}},{"Re":{"pattern":"[\\-]"}},{"Alternative":{"atoms":[25,26,27,28,29,30,31]}},{"Repetition":{"atom":24,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"draft_rest","atom":33}},{"Sequence":{"atoms":[23,34]}},{"Alternative":{"atoms":[0,10,22]}}],"root":36},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"RFC 2616","expect":{}},{"entry":"identifier","kind":"accept","input":"RFC2616","expect":{}},{"entry":"identifier","kind":"accept","input":"BCP 14","expect":{}},{"entry":"identifier","kind":"accept","input":"draft-ietf-httpbis-messaging-19","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/ietf/parser.rb: three families keyed on the leading\n# token — RFC, sub-series (BCP/STD/FYI, padded forms allowed), and\n# Internet-Drafts (the wide draft tail is safe: the alternation is\n# leading-token keyed).\n\ngrammar PubidIetf version \"0.1.0\" {\n  rfc = \"RFC\" [space] (1*digit) as number\n  subseries = (\"BCP\" / \"STD\" / \"FYI\") as series [space] (1*digit) as number\n  draft_rest_char = %x30-39 / %x41-5A / %x61-7A / %x2B / %x5F / %x2E / %x2D\n  draft = \"draft-\" (1*draft_rest_char) as draft_rest\n  identifier = rfc / subseries / draft\n  digit = %x30-39\n  space = \" \"\n  entry identifier: identifier\n\n  test {\n    accept \"RFC 2616\"\n    accept \"RFC2616\"\n    accept \"BCP 14\"\n    accept \"draft-ietf-httpbis-messaging-19\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"99b3cfa2980049fb46da3945381eaaa22a391ac93d31694a68ab33c51332fb87","compiler_version":"1.3.93","checksum":"sha256:a04eff13c92f4a66514681c3249b7861329b2c6237bf727bd5fbf9146b06e82b"}
