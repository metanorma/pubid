}},{"entry":"identifier","kind":"accept","input":"EVS-TS 1:2019","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS-TR 1:2019","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS-ISO 9001:2015","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS-IEC 62368-1:2020","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS-EN 1993-1-1:2005+NA:2010","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS-EN 1993-1-1:2005/NA","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS-EN 50581:2012+COR:2015","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS-EN 50581:2012+AC:2015","expect":{}},{"entry":"identifier","kind":"accept","input":"EVS-EN 71-1:2011 AMD1:2014","expect":{}},{"entry":"identifier","kind":"accept","input":"prEVS-EN 100:2026","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}},{"entry":"cen_cenelec.identifier","kind":"accept","input":"EN 18216:2026","expect":{}},{"entry":"cen_cenelec.identifier","kind":"accept","input":"EN ISO 9001:2015","expect":{}},{"entry":"cen_cenelec.identifier","kind":"accept","input":"CEN/CLC TR 17161:2019","expect":{}},{"entry":"cen_cenelec.identifier","kind":"accept","input":"EN 196-1:2016+A1","expect":{}},{"entry":"cen_cenelec.identifier","kind":"accept","input":"CEN/CLC/ETSI/TR 101551:2026","expect":{}},{"entry":"cen_cenelec.identifier","kind":"accept","input":"EN 302 326-2:2026","expect":{}},{"entry":"cen_cenelec.identifier","kind":"accept","input":"EN 302 326-2 V2.2.1","expect":{}},{"entry":"cen_cenelec.identifier","kind":"accept","input":"EN 302 326 V2.2.1:2026","expect":{}},{"entry":"cen_cenelec.identifier","kind":"accept","input":"EN 302:2026","expect":{}},{"entry":"cen_cenelec.identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# The EVS national identifier: the national prefix (\"EVS\" / \"prEVS\") over a\n# CEN/CENELEC adoption, an ISO/IEC adoption, or a plain Estonian standard —\n# plus the EVS-list supplements (national annex, corrigendum, AMD amendment)\n# and the language code. The CEN spine is IMPORTED via `use` (TODO 11/C6\n# imports): rules are namespaced cen_cenelec.* while captures keep their\n# contract names.\n\nuse cen_cenelec\n\ngrammar PubidEvs version \"0.3.0\" {\n  identifier = [draft_prefix] \"EVS\" evs_separator ((cen_cenelec.identifier) as adopted / (evs_intl) as intl / (evs_plain) as plain) [evs_amd] [evs_cor / evs_ac] [evs_na]\n\n  draft_prefix = \"pr\" as draft_prefix\n  evs_separator = (dash / space) as evs_separator\n\n  # \"EVS-ISO 9001:2015\", \"EVS-IEC 62368-1:2020\" (+ their amendments)\n  evs_intl = ((((\"ISO\" / \"IEC\") as intl_org) space (1*digit) as number) [(dash (1*digit) as part)] [(colon (4digit) as year)])\n  # \"EVS 921:2019\", \"EVS-TS 1:2019\", \"EVS-TR 1:2019\"\n  evs_plain = [((\"TS\" / \"TR\") as evs_type) space] (1*digit) as number [(colon (4digit) as year)]\n\n  # \" AMD1:2014\" / \"+AMD1\" — the AMD amendment spelling; the separator is\n  # semantic (list: \"+A full standard plus the amendment\", \"/A only amendment\")\n  evs_amd = (((plus as supp_plus / slash as supp_slash / space as supp_space) (\"AMD\" as amd_kind)) (1*digit) as amd_number [(colon (4digit) as amd_year)]) as evs_amd\n  # \"+COR:2015\" / \"/COR\" — the COR spelling (the CEN spine consumes +AC itself)\n  evs_cor = (((plus as supp_plus / slash as supp_slash) (\"COR\" as cor_kind)) [(1*digit) as cor_number] [(colon (4digit) as cor_year)]) as evs_cor\n  # \" AC:2015\" — the space-separated AC spelling\n  evs_ac = ((space as supp_space) (\"AC\" as cor_kind) [(1*digit) as cor_number] [(colon (4digit) as cor_year)]) as evs_cor\n  # \"+NA:2010\" / \"/NA\" — the national annex\n  evs_na = (((plus as supp_plus / slash as supp_slash) \"NA\") [(colon (4digit) as na_year)]) as na\n  # The trailing language code (\" et\" / \" en\" / \" et-en\") is extracted by\n  # the parse wrapper (Pubid::Evs.parse) BEFORE the grammar runs — the\n  # CEN adopted_string is greedy over plain text and would swallow it.\n\n  digit = %x30-39\n  dash = \"-\"\n  space = \" \"\n  plus = \"+\"\n  slash = \"/\"\n  colon = \":\"\n\n  entry identifier: identifier\n\n  test {\n    accept \"EVS-EN 18216:2026\"\n    accept \"EVS-EN ISO 9001:2015/A1:2024\"\n    accept \"EVS EN 196-1:2016\"\n    accept \"EVS 921:2019\"\n    accept \"EVS-TS 1:2019\"\n    accept \"EVS-TR 1:2019\"\n    accept \"EVS-ISO 9001:2015\"\n    accept \"EVS-IEC 62368-1:2020\"\n    accept \"EVS-EN 1993-1-1:2005+NA:2010\"\n    accept \"EVS-EN 1993-1-1:2005/NA\"\n    accept \"EVS-EN 50581:2012+COR:2015\"\n    accept \"EVS-EN 50581:2012+AC:2015\"\n    accept \"EVS-EN 71-1:2011 AMD1:2014\"\n    accept \"prEVS-EN 100:2026\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"0b4cb52e9c6ec1beadb59a7d52f152c817f70bd67cc5e44194419cb536b679fc","compiler_version":"1.3.93","checksum":"sha256:f3954ca983e4bf132f0a978e8ddf9f80e9dfd2a862841380387eae40a7c7fcc1"}
