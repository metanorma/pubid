ept \"G1040\"\n    accept \"GA1040\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"21d282f6ed3a1c0ac8a3a3240beed0cb4f0942f09f1e76be2103a2093b9453bd","compiler_version":"1.3.93","checksum":"sha256:69f6e8a2a70f9c9211fffc2833037eff92ae312cce7d5e45f69dd7e9f7832867"}
