{"atoms":[10,20,22,23,28,29,34,63,76,88,149,164]}}],"root":165},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":["rule supplement: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule supplement: branches 1 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule supplement: branches 2 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule symbol_value_char: branches 1 and 2 are order-dependent (first set not statically known)"]},"default_entry":"identifier","render":{},"derive":{},"tests":[{"entry":"identifier","kind":"accept","input":"JIS B 0001","expect":{}},{"entry":"identifier","kind":"accept","input":"JIS X 0208:1997","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/jis/parser.rb — JIS identifiers with the Japanese\n# full-width separator tolerance (ｰ 　 ： （）), TR/TS prefixes, parts,\n# reaffirmed years, (E)/(J) language codes, 規格群 all-parts, AMD/EXPL/\n# CORR supplements, and the SYMBOL clause.\n\ngrammar PubidJis version \"0.1.0\" {\n  dash = (\"-\" / \"ｰ\") as dash\n  space = (\" \" / \"　\")\n  colon = (\":\" / \"：\")\n  type_prefix = (\"TR\" / \"TS\") as type (space / slash)\n  series = upper as series\n  number = (1*digit) as number\n  part = dash (1*digit) as part\n  parts = (*part) as parts\n  reaffirmed = \"R\" (*\"R\")\n  year = colon (1*digit) as year ([reaffirmed]) as reaffirmed\n  language = (\"(\" / \"（\") (\"E\" / \"J\") as language (\")\" / \"）\")\n  all_parts = ((\"（\" \"規格群\" \"）\") / (\"(\" \"規格群\" \")\")) as all_parts\n  amendment = slash (\"AMENDMENT\" / \"AMD\") as amd_type space (1*digit) as amd_number colon (1*digit) as amd_year ([\"R\" (*\"R\")]) as amd_reaffirmed\n  explanation = slash (\"EXPLANATION\" / \"EXPL\") as expl_type ([space (1*digit) as expl_number])\n  corrigendum = slash (\"CORRIGENDUM\" / \"CORR\") as corr_type space (1*digit) as corr_number colon (1*digit) as corr_year ([\"R\" (*\"R\")]) as corr_reaffirmed\n  supplement = (amendment as amendment) / (explanation as explanation) / (corrigendum as corrigendum)\n  symbol_value_char = %x01-09 / %x0B-10FFFF\n  symbol_clause = space \"SYMBOL\" as symbol_present ([space (1*symbol_value_char) as symbol_value])\n  identifier = [\"JIS\" [(space / slash)]] [type_prefix] [space] series [space] number parts [year] [language] [all_parts] [supplement] [symbol_clause]\n  upper = %x41-5A\n  digit = %x30-39\n  slash = \"/\"\n  entry identifier: identifier\n\n  test {\n    accept \"JIS B 0001\"\n    accept \"JIS X 0208:1997\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"0b4f3aa215c6851c3fbc57b07539ef7f54842285543850b274677c1c6a9dd280","compiler_version":"1.3.93","checksum":"sha256:62fd1bbd12e4e84f6e480c14dfeb0a007dc4de4f8d7988abb98eba429d9faff5"}
