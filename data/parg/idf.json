om":173}},{"Entity":{"atom":120}},{"Entity":{"atom":168}},{"Sequence":{"atoms":[171,172]}},{"Alternative":{"atoms":[0,170]}}],"root":174},"bindings":[]}},"preprocess":{},"tables":{"idf_typed_stages":{"file":"idf_typed_stages.yaml","rows":[{"abbr":"PWI RM"},{"abbr":"NP RM"},{"abbr":"AWI RM"},{"abbr":"WD RM"},{"abbr":"CD RM"},{"abbr":"PDRM"},{"abbr":"DRM"},{"abbr":"FDRM"},{"abbr":"PRF RM"},{"abbr":"RM"},{"abbr":"AMD"},{"abbr":"COR"},{"abbr":"PWI"},{"abbr":"NP"},{"abbr":"NWIP"},{"abbr":"AWI"},{"abbr":"WD"},{"abbr":"CD"},{"abbr":"FCD"},{"abbr":"DIS"},{"abbr":"FPD"},{"abbr":"FDIS"},{"abbr":"PRF"},{"abbr":"Fpr"},{"abbr":"WDR"},{"abbr":"WDA"},{"abbr":"WDAR"}]},"idf_typed_stages_supplements":{"file":"idf_typed_stages_supplements.yaml","rows":[{"abbr":"AMD"},{"abbr":"COR"}]}},"lint":{"order_warnings":["rule dash: branches 2 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule identifier: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)"]},"default_entry":"identifier","render":{},"derive":{},"tests":[],"docs":{},"source":"# Port of lib/pubid/idf/parser.rb: IDF identifiers and their\n# supplements. The ISO joint form (ISO 5537|IDF 26) inlines these rules\n# as idf_* in iso.pg.\n\ngrammar PubidIdf version \"0.1.0\" {\n  digit = %x30-39\n  word_char = %x30-39 / %x41-5A / %x61-7A / %x5F\n  dash = \"-\" / \"‑\" / \"‐\"\n  dot = \".\"\n  slash = \"/\"\n  space = \" \"\n  colon = \":\"\n  letter = %x41-5A / %x61-7A\n  lower = %x61-7A\n  century = \"19\" / \"20\"\n  year_digits = century 2*digit !digit\n  month_digits = 2*digit\n  day_digits = 2*digit\n  publisher = \"IDF\" as publisher\n  number = 1*5word_char\n  part_and_subpart = dash [space] 1*word_char *1(dash 1*word_char)\n  number_with_part = (number [part_and_subpart]) as number_with_part\n  date = (year_digits [(dash month_digits)] [(dash day_digits)]) as date\n  stage_iteration = dot digit as stage_iteration\n  second_part = number_with_part [stage_iteration] [space] [(colon date)]\n  all_parts = \"(all parts)\" as all_parts\n  language = \"(\" *(1*lower [\",\"] / (one_of_efards [slash])) as languages \")\"\n  one_of_efards = %x45 / %x46 / %x41 / %x52 / %x44 / %x53\n  third_part = [space] [language] [all_parts]\n  identifier_publisher_no_third = publisher [space] [slash] [type_with_stage] [space] second_part\n  identifier_publisher = identifier_publisher_no_third third_part\n  type_with_stage = alt from_table \"idf_typed_stages\" column \"abbr\" as type_with_stage [digit as stage_iteration space]\n  supplement_type_with_stage = alt from_table \"idf_typed_stages_supplements\" column \"abbr\" as type_with_stage\n  supplement_identifier_no_third = (identifier_publisher_no_third as base) [space] slash [space] supplement_type_with_stage [space] second_part\n  supplement_identifier = supplement_identifier_no_third third_part\n  identifier = supplement_identifier / identifier_publisher\n\n  entry identifier: identifier\n}\n","source_hash":"003db1b987581830be83c1eed083ae3a02d23facba0ae8e496046b6914ff623f","compiler_version":"1.3.93","checksum":"sha256:f17f36891ddfb0594cf57ce6c2a6005b7c8baa7fa8bbd7c3f2e89210091ad7c3"}
